# SettleTrace configuration.
#
# Copy this file to `.env` in this same directory (the project root) and fill
# in the values. The path is anchored to the project root, so it is picked up
# no matter which directory you start the server from.
#
# Nothing here is required: with an empty file the app runs entirely on
# generated sample data with template explanations, and says so in the UI.
# Restart the backend after editing - values are read once at startup.

# --- LLM explanations (pick ONE; all optional) ----------------------------
# Only used to write plain-language explanations of exceptions that have
# already been computed. The reconciliation results are identical with or
# without a key - the model never touches a match decision.
#
# Missing or invalid: explanations use deterministic template text and the
# header badge reads "AI: fallback mode". Nothing crashes.

# GEMINI - free, no card required. Recommended.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GROQ - also free, no card. Use if Gemini is unavailable.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# ANTHROPIC - paid (prepaid credits).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which provider to use. "auto" (the default) picks whichever key is present,
# preferring groq, then gemini, then anthropic. Set explicitly to override:
# gemini | groq | anthropic
LLM_PROVIDER=auto

# Model override. Leave blank to use the provider's default:
#   gemini    -> gemini-3.6-flash
#   groq      -> openai/gpt-oss-120b
#   anthropic -> claude-sonnet-5
LLM_MODEL=

# --- Razorpay (optional) --------------------------------------------------
# Where to get these: Razorpay Dashboard > (switch to Test Mode) > Settings >
# API Keys > Generate Test Key. The secret is shown only once - copy it then.
# Requires a business account; the demo does not need these.
# Missing or invalid: the app falls back to generated sample data and shows a
# "Sandbox unavailable - showing generated data" banner. It never crashes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set to true to reconcile live sandbox data instead of generated data.
# Leave false (or unset) to run the deterministic demo.
SETTLETRACE_USE_SANDBOX=false

# --- Storage --------------------------------------------------------------
# SQLite file, created automatically on first run.
DATABASE_URL=sqlite:///./settletrace.db
